<div class="max-w-xl mx-auto space-y-6 animate-fade-in">
  <div class="flex items-center justify-between">
    <a href="<%= meal_path(@meal) %>" class="inline-flex items-center gap-2 text-sm font-medium text-slate-400 hover:text-white transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Retour au repas
    </a>
  </div>

  <div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl space-y-6 shadow-2xl">
    <div class="space-y-1">
      <h2 class="text-2xl font-bold text-white">Modifier le Repas</h2>
      <p class="text-slate-400 text-sm">Ajustez l'objectif calorique ou le nom du repas.</p>
    </div>

    <%= form_with(model: @meal, local: true, class: "space-y-5") do |f| %>
      <% if @meal.errors.any? %>
        <div class="p-4 rounded-xl bg-rose-950/60 border border-rose-500/30 text-rose-300 text-sm">
          <ul class="list-disc list-inside space-y-1">
            <% @meal.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-2">
        <%= f.label :name, "Nom du repas", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider" %>
        <%= f.text_field :name, class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors" %>
      </div>

      <div class="space-y-2">
        <%= f.label :target_kcal, "Objectif calorique (kcal)", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider" %>
        <%= f.number_field :target_kcal, min: 50, step: 10, class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors" %>
      </div>

      <div class="space-y-2">
        <%= f.label :strategy, "Mode de répartition", class: "block text-xs font-semibold text-slate-300 uppercase tracking-wider" %>
        <%= f.select :strategy, [
          ["Proportionnel (Conserve le ratio relatif)", "proportional"],
          ["Équilibré (Répartit les kcal restantes à égalité)", "balanced"],
          ["Prioritaire (Remplit les ingrédients séquentiellement)", "priority"]
        ], {}, class: "w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors" %>
      </div>

      <div class="pt-4 flex items-center justify-between">
        <%= button_to "Supprimer ce repas", meal_path(@meal), method: :delete, data: { turbo_confirm: "Êtes-vous sûr de vouloir supprimer ce repas ?" }, class: "text-xs font-semibold text-rose-400 hover:text-rose-300 cursor-pointer" %>
        <div class="flex gap-3">
          <a href="<%= meal_path(@meal) %>" class="px-4 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white transition-colors">Annuler</a>
          <%= f.submit "Enregistrer", class: "px-6 py-2.5 rounded-xl text-sm font-bold bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-md shadow-emerald-500/20 transition-all cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
