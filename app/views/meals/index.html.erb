<div class="space-y-8 animate-fade-in">
  <!-- Header Banner -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-8 rounded-3xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl relative overflow-hidden shadow-2xl">
    <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="space-y-2 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Équilibrage Automatique Kcal
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">Vos Repas Équilibrés</h1>
      <p class="text-slate-400 text-sm max-w-xl">
        Ajustez vos portions en temps réel grâce aux curseurs intelligents. Les autres ingrédients s'adaptent instantanément pour respecter votre objectif calorique.
      </p>
    </div>

    <div class="flex gap-3 relative z-10">
      <a href="<%= new_meal_path %>" class="inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl text-sm font-bold bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-lg shadow-emerald-500/25 transition-all hover:scale-[1.02] active:scale-[0.98]">
        <svg class="w-5 h-5 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <span>Créer un Repas</span>
      </a>
    </div>
  </div>

  <!-- Meals List -->
  <% if @meals.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @meals.each do |meal| %>
        <div class="group relative rounded-3xl bg-slate-900/50 border border-slate-800/80 p-6 backdrop-blur-md hover:border-slate-700 transition-all duration-300 hover:shadow-xl hover:shadow-emerald-500/5 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="text-xl font-bold text-white group-hover:text-emerald-400 transition-colors">
                  <a href="<%= meal_path(meal) %>"><%= meal.name %></a>
                </h3>
                <span class="text-xs text-slate-500 font-medium capitalize">
                  Stratégie : <%= meal.strategy == 'proportional' ? 'Proportionnelle' : (meal.strategy == 'balanced' ? 'Équilibrée' : 'Prioritaire') %>
                </span>
              </div>
              <div class="text-right">
                <span class="text-2xl font-black text-emerald-400 tracking-tight"><%= meal.target_kcal %></span>
                <span class="text-xs text-slate-500 font-semibold uppercase block -mt-1">kcal cible</span>
              </div>
            </div>

            <!-- Ingredients Badges -->
            <div class="space-y-2">
              <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Ingrédients (<%= meal.meal_ingredients.count %>)</div>
              <div class="flex flex-wrap gap-1.5">
                <% meal.meal_ingredients.each do |mi| %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-xs font-medium bg-slate-800/80 text-slate-300 border border-slate-700/50">
                    <%= mi.ingredient.name %>
                    <span class="text-emerald-400 font-semibold"><%= mi.grams %>g</span>
                  </span>
                <% end %>
                <% if meal.meal_ingredients.empty? %>
                  <span class="text-xs text-slate-500 italic">Aucun ingrédient encore.</span>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Bottom Card Progress & Actions -->
          <div class="mt-6 pt-4 border-t border-slate-800/60 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-2.5 h-2.5 rounded-full <%= meal.exceeded? ? 'bg-rose-500 animate-ping' : 'bg-emerald-400' %>"></div>
              <span class="text-xs font-semibold text-slate-400">
                <%= meal.total_kcal %> / <%= meal.target_kcal %> kcal
              </span>
            </div>

            <div class="flex items-center gap-2">
              <a href="<%= edit_meal_path(meal) %>" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors" title="Modifier le nom">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
              </a>
              <a href="<%= meal_path(meal) %>" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white transition-colors">
                Ouvrir
              </a>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="p-12 text-center rounded-3xl bg-slate-900/40 border border-slate-800/80 space-y-4 max-w-lg mx-auto">
      <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mx-auto text-2xl">
        🥗
      </div>
      <h3 class="text-xl font-bold text-white">Aucun repas créé pour le moment</h3>
      <p class="text-slate-400 text-sm">
        Commencez par ajouter votre premier repas (ex: 650 kcal) pour commencer l'équilibrage nutritionnel.
      </p>
      <a href="<%= new_meal_path %>" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-all">
        + Créer un premier repas
      </a>
    </div>
  <% end %>
</div>
